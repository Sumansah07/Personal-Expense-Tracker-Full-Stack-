# Server Configuration
PORT=8080
NODE_ENV=production

# Database Configuration
# For local development with Docker
# DATABASE=mongodb://mongo:27017/expense-tracker

# For MongoDB Atlas (recommended for Railway deployment)
DATABASE=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expense-tracker?retryWrites=true&w=majority

# Security
# Replace with a strong random string in production
SECRET_KEY=your_secret_key_here

# Google Gemini API (for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Authentication (for local Docker setup only)
# MONGO_USER=username
# MONGO_PASSWORD=password
