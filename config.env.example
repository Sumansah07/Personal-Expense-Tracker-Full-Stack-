# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
DATABASE=mongodb://mongo:27017/expense-tracker
# If using MongoDB authentication, uncomment and set these:
# DATABASE=mongodb://username:password@mongo:27017/expense-tracker
# MONGO_USER=username
# MONGO_PASSWORD=password

# Security
# Replace with a strong random string in production
SECRET_KEY=your_secret_key_here

# Optional: Google Gemini API (for AI features)
# GEMINI_API_KEY=your_gemini_api_key_here
